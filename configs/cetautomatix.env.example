# Copy this file to configs/cetautomatix.env, verify the paths, then:
#   source configs/cetautomatix.env

export SRESNET_DATA_ROOT=/data/abdekess61/SResNet
export MAD_DATA_ROOT=/data/abdekess61/datasets/lab_gesture_dataset
export MAD_EXTRACT_DIR=/data/abdekess61/datasets/lab_gesture_dataset/extracted
export MAD_CACHE_DIR=/data/abdekess61/SResNet/MAD_cache

# DVS-GC standard.  For overlap 0/7/8, use /data/abdekess61/SResNet.
export DVSGC_DATA_ROOT=/users/abdekess61/datasets/SResNet

# W&B is offline by default for reproducible, non-interactive runs.
export WANDB_MODE=offline
export SEED=123
export DETERMINISTIC=0
